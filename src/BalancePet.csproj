<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>balance-pet</AssemblyName>
    <RootNamespace>BalancePet</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <AssemblyTitle>余额桌宠</AssemblyTitle>
    <Product>余额桌宠</Product>
    <Version>1.2.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The installer has its own Main() and is built separately by build.ps1. -->
    <Compile Remove="Setup.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\profiles\*.json">
      <LogicalName>BalancePet.Profiles.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Provides net48 reference assemblies so this project builds on machines (and CI images)
         that do not have the full .NET Framework targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
